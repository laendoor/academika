{
	"info": {
		"name": "Académika API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Endpoints de Académika. Fiel al código actual: los CRUD de dominio (carreras, materias, planes, alumnos, cursadas) aún no requieren auth — se protegerán en #65, donde se actualizará esta collection. El WebSocket `/ws` no se incluye (Postman v2.1 no lo soporta)."
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000", "type": "string" },
		{ "key": "access_token", "value": "", "type": "string" },
		{ "key": "refresh_token", "value": "", "type": "string" },
		{ "key": "carrera_id", "value": "", "type": "string" },
		{ "key": "materia_id", "value": "", "type": "string" },
		{ "key": "plan_id", "value": "", "type": "string" },
		{ "key": "alumno_id", "value": "", "type": "string" },
		{ "key": "cursada_id", "value": "", "type": "string" },
		{ "key": "user_id", "value": "", "type": "string" },
		{ "key": "invite_token", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "GET /health",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/health"
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "POST /auth/login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"  const json = pm.response.json();",
									"  pm.collectionVariables.set('access_token', json.access_token);",
									"  pm.collectionVariables.set('refresh_token', json.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"lean@unq.edu.ar\",\n  \"password\": \"Test1234!\"\n}"
						}
					}
				},
				{
					"name": "POST /auth/refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"  const json = pm.response.json();",
									"  pm.collectionVariables.set('access_token', json.access_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/refresh",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						}
					}
				},
				{
					"name": "POST /auth/invite (admin)",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/invite",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"nuevo@unq.edu.ar\",\n  \"role\": \"docente\"\n}"
						}
					}
				},
				{
					"name": "POST /auth/register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"  const json = pm.response.json();",
									"  pm.collectionVariables.set('access_token', json.access_token);",
									"  pm.collectionVariables.set('refresh_token', json.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/register",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{invite_token}}\",\n  \"password\": \"Test1234!\"\n}"
						}
					}
				},
				{
					"name": "POST /auth/forgot-password",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/forgot-password",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"lean@unq.edu.ar\"\n}"
						}
					}
				},
				{
					"name": "POST /auth/reset-password",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/v1/auth/reset-password",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"\",\n  \"new_password\": \"NewPassword1!\"\n}"
						}
					}
				}
			]
		},
