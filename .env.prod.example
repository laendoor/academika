# ── PostgreSQL (contenedor postgres) ─────────────────────────────────────────
POSTGRES_USER=academika
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=academika

# ── API (contenedor api) ─────────────────────────────────────────────────────
# DATABASE_URL debe usar el MISMO password que POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://academika:CHANGE_ME@postgres:5432/academika

# JWT_SECRET_KEY es compartido entre api y ui (mismo valor). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_HOURS=1
INVITE_TOKEN_EXPIRE_HOURS=72

# Resend (email). RESEND_FROM_EMAIL debe ser un dominio verificado en Resend.
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=noreply@academika.net.ar
FRONTEND_URL=https://academika.net.ar

# ── UI (contenedor ui) ───────────────────────────────────────────────────────
# API_URL es server-side (BFF), apunta al contenedor api por la red docker.
API_URL=http://api:8000
# WS_URL es client-side (browser), pasa por nginx con TLS.
WS_URL=wss://academika.net.ar/ws
