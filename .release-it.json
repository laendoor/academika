{
	"git": {
		"commitMessage": "chore: bump v${version}",
		"tagName": "v${version}"
	},
	"npm": {
		"publish": false
	},
	"github": {
		"release": true,
		"releaseName": "v${version}"
	},
	"hooks": {
		"after:bump": "node scripts/sync-versions.mjs && git add web/package.json web/package-lock.json api/pyproject.toml"
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": "conventionalcommits"
		}
	}
}
